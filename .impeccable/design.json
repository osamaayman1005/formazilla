 "narrative": {
  "northStar": "The Sticker Album",
  "overview": "Every workout is a page in a football sticker album. Each logged set is a dark sticker with a light-blue edge stuck into its slot; each personal record is a foil. The empty slot shows last time's number printed inside it, so repeating a weight is tap and Save. The album world lives only in the numbers; everything around them is plain Material 3 on the app's original navy. Ease of use outranks looks.",
  "keyCharacteristics": [
   "Navy page, white paper stickers, navy foils with one light-blue sheen band.",
   "Condensed heavy Archivo numerals, tabular, as the loudest thing on every screen.",
   "One navy header band per page marks the current exercise or the page's subject.",
   "56 px main buttons in a bottom bar; nothing tappable under 48 px.",
   "Every action is a labelled button or a visible handle; no secret gestures."
  ],
  "rules": [
   {
    "name": "The Paper Is Earned Rule",
    "body": "White paper appears only for a logged set, a logged cardio time, or an exercise's best in Progress. Letter and number badges use Chip Navy with Foil Sheen text. Nothing decorative is ever white.",
    "section": "colors"
   },
   {
    "name": "The Fresh Foil Rule",
    "body": "Foil marks a PR from the latest workout (and the Recent PRs strip). Older bests are white paper, so today's wins stand out.",
    "section": "colors"
   },
   {
    "name": "The One Band Rule",
    "body": "One navy header band per screen, over the thing being worked on now.",
    "section": "colors"
   },
   {
    "name": "The Numbers Shout Rule",
    "body": "The weight is always the biggest, heaviest text in its area.",
    "section": "typography"
   },
   {
    "name": "The Tilt Means New Rule",
    "body": "Only the newest sticker or a PR foil is tilted. Everything else sits straight.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do put the screen's main action in the bottom bar at 56 px.",
   "Do open the keypad with the printed weight selected from the slot, and a clean keypad from +.",
   "Do show every action as a labelled button or visible handle (drop set, superset, edit, reorder, remove).",
   "Do use foils only for real PRs, and tilt only the newest sticker.",
   "Do keep data untouched in any redesign: same models, same formazilla.json, same signing key."
  ],
  "donts": [
   "Don't prefill the keypad from +; the user has to erase before typing.",
   "Don't hide actions behind long-press or swipe alone.",
   "Don't put stickers on menus, tabs or sheets; the album lives only in sets and PRs.",
   "Don't add drop shadows, gradients or glow; depth is tonal plus the sticker tilt.",
   "Don't add tabs or change their order."
  ]
 }
}